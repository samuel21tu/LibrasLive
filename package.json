{
  "name": "libraslive",
  "version": "1.0.0",
  "private": true,
  "description": "LibrasLive — overlay de LIBRAS em tempo real com Rust/Tauri 2",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "android:build": "npm run build && tauri android build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --workspace",
    "typecheck": "tsc --noEmit",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "lint:web": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "9.117.3",
    "@react-three/fiber": "8.17.10",
    "@tauri-apps/api": "^2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "^5.7.2",
    "vite": "5.4.11",
    "vitest": "^2.1.8"
  }
}
